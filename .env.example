# Copy to .env to override the local defaults in compose.yaml. A deployment sets all of
# these from its secret store; nothing here is a real credential.

# PostgreSQL
POSTGRES_PASSWORD=
# SQL Server of the Service Bus emulator. Local only; it needs a strong password.
MSSQL_SA_PASSWORD=
FRONTDESK_OWNER_PASSWORD=
FRONTDESK_APP_PASSWORD=

# Runtime, read by the API and the worker
FRONTDESK_DATABASE_URL=postgresql+psycopg://frontdesk_app:<app password>@<host>:5432/frontdesk
FRONTDESK_QUEUE_NAME=triggers
# In Azure: the namespace host. The process signs in with its managed identity.
FRONTDESK_SERVICEBUS_NAMESPACE=<namespace>.servicebus.windows.net
# Only for the Service Bus emulator. Leave unset in Azure.
FRONTDESK_SERVICEBUS_CONNECTION_STRING=
# Conversations one worker handles side by side. The emulator allows ten connections.
FRONTDESK_WORKER_CONCURRENCY=6
# Seconds a customer has to be silent before the agent answers, so that a burst of short
# messages becomes one turn. 0 answers at once.
FRONTDESK_QUIET_WINDOW_SECONDS=1.5

# Model. "offline" is the deterministic stand-in and needs nothing else.
FRONTDESK_MODEL_PROVIDER=offline
# The deployment name on Azure OpenAI, which is also the key of the price table.
FRONTDESK_MODEL=offline
FRONTDESK_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# Only for local use. Leave unset in Azure, where the managed identity is used.
FRONTDESK_AZURE_OPENAI_API_KEY=

# Shared between the panel's server and the API. At least 32 random characters.
FRONTDESK_WEBCHAT_SECRET=

# Database setup, read only by `python -m frontdesk.setup`
FRONTDESK_SUPERUSER_DSN=postgresql://postgres:<superuser password>@<host>:5432/postgres
FRONTDESK_DATABASE_NAME=frontdesk
# Password of the demo owner accounts (dono@navalha.example, dono@ponto-final.example).
# Unset means no owner accounts are created and the panel cannot be signed in to.
FRONTDESK_DEMO_OWNER_PASSWORD=
FRONTDESK_MIGRATIONS_DATABASE_URL=postgresql+psycopg://frontdesk_owner:<owner password>@<host>:5432/frontdesk

# Panel (Next.js server)
FRONTDESK_API_URL=http://<api host>:8000
# Set to true only when serving plain HTTP on a developer machine.
FRONTDESK_INSECURE_COOKIES=

# Local ports published by compose
FRONTDESK_API_PORT=8700
FRONTDESK_WEB_PORT=3700
